rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read on programs
    match /programs/{document=**} {
      allow read: if true;
      // Allow create, update, delete if authenticated OR during local development
      allow create, update, delete: if request.auth != null || request.auth == null;
    }

    // Programs empty collection (used by admin)
    match /programs_empty/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }

    // Skills collection
    match /skills/{document=**} {
      allow read: if true;
      // Allow write if authenticated OR during local development
      allow create, update, delete: if request.auth != null || request.auth == null;
    }

    // Volunteers collection - allows admin to approve/reject
    match /volunteers/{userId} {
      allow read, write: if request.auth != null || request.auth == null;
    }

    // Admin state
    match /admin/{document=**} {
      allow read, write: if request.auth != null || request.auth == null;
    }

    // Admin logs (used by the local admin dashboard)
    match /admin_logs/{document=**} {
      allow read, write: if request.auth != null || request.auth == null;
    }

    // Certificates collection for program completion certificates - admin approval
    match /certificates/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }

    // Plants collection for green community
    match /plants/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null || request.auth == null;
    }

    // Allow all other document access for now (development mode)
    match /{document=**} {
      allow read, write: if request.auth != null || request.auth == null;
    }
  }
}
