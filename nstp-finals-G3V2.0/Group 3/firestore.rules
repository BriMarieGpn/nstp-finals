rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Programs: public read, auth required to write
    match /programs/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Programs (legacy collection): public read, auth required to write
    match /programs_empty/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Skills: PUBLIC read so signup + user dashboard can fetch the list
    // Only authenticated admins can write
    match /skills/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Volunteers collection
    match /volunteers/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin state
    match /admin/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
